{"lines":[{"id":"d01","figure":"s20","speaker":"成人，独行，撑伞","tone":"自语，喘气","text":"风好大……"},{"id":"d02","figure":"s20","speaker":"成人，独行，撑伞","tone":"自语，咬牙","text":"再上一段就好。"},{"id":"d03","figure":"s19","speaker":"成人，步行","tone":"高声招呼，隔着风","text":"过了桥再歇！"},{"id":"d04","figure":"s19","speaker":"成人，骑驴","tone":"催促","text":"走啊，驴儿！"},{"id":"d05","figure":"s19","speaker":"成人，挑担","tone":"吃力，短促","text":"担子湿透了。"},{"id":"d06","figure":"s15","speaker":"成人，挑担","tone":"催赶","text":"快些，天要黑了。"},{"id":"d07","figure":"s15","speaker":"童，拄杖","tone":"小声，带点委屈","text":"鞋都湿了……"},{"id":"d08","figure":"s15","speaker":"成人，骑驴","tone":"安抚","text":"跟紧，就到家。"},{"id":"d09","figure":"s11","speaker":"成人，回身的那位","tone":"回头喊","text":"当心脚下滑！"},{"id":"d10","figure":"s11","speaker":"成人，弯腰的那位","tone":"低声应","text":"晓得，晓得。"},{"id":"d11","figure":"s14","speaker":"成人，倚门","tone":"张望，自语","text":"怎么还不回……"},{"id":"d12","figure":"s07","speaker":"成人，探身向前的那位","tone":"指着远处","text":"看，有人回来了。"},{"id":"d13","figure":"s07","speaker":"成人，转身的那位","tone":"转头招呼","text":"快去开门。"},{"id":"d14","figure":"s04","speaker":"成人，披蓑衣撑篙","tone":"沉稳，用力","text":"坐稳了。"},{"id":"d15","figure":"s04","speaker":"成人，戴斗笠坐着","tone":"望着岸","text":"雨越下越密。"},{"id":"d16","figure":"s19","speaker":"成人，骑驴，年长","tone":"低沉，慢","text":"慢些走，路滑。"},{"id":"d17","figure":"s14","speaker":"成人，倚门","tone":"迎上去，高声招呼","text":"可算回来了！","event":true},{"id":"d18","figure":"s15","speaker":"成人，骑驴","tone":"笑着应","text":"回来了，回来了。","event":true},{"id":"d19","figure":"s01","speaker":"成人，船上撑伞","tone":"自语，小声","text":"雨大，先躲一躲。"},{"id":"d20","figure":"s22","speaker":"成人，披蓑衣撑篙","tone":"高声招呼","text":"坐稳了，起风了！"},{"id":"d21","figure":"s22","speaker":"成人，戴斗笠坐着","tone":"低声","text":"这雨怕是要下一夜。"},{"id":"d22","figure":"s22","speaker":"成人，戴斗笠坐着的另一位","tone":"平常","text":"靠了岸就好。"},{"id":"d23","figure":"s23","speaker":"成人，戴斗笠坐着","tone":"高声问","text":"船家，还有多远？"},{"id":"d24","figure":"s23","speaker":"成人，披蓑衣撑篙","tone":"平常","text":"转过这片水就到。"},{"id":"d25","figure":"s24","speaker":"成人，篷下坐着","tone":"平常","text":"篷子漏雨了。"},{"id":"d26","figure":"s24","speaker":"成人，篷下坐着的另一位","tone":"平常","text":"往里挪挪。"},{"id":"d27","figure":"s03","speaker":"成人，泊船里","tone":"平常","text":"今晚就泊在这儿吧。"},{"id":"d28","figure":"s05","speaker":"成人，抱着孩子","tone":"低声","text":"把孩子裹紧些，别着凉。"},{"id":"d29","figure":"s08","speaker":"童，够门环","tone":"高声","text":"我来开门！"},{"id":"d30","figure":"s08","speaker":"成人，拄杖笑着","tone":"笑着催","text":"慢些，别摔着。"}]}